{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production approval contract, not issuer implementation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "request_digest",
    "signer_id",
    "signer_role",
    "key_id",
    "decision",
    "issued_at",
    "expires_at",
    "nonce",
    "scope",
    "signature"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "signer_role": {
      "enum": [
        "Owner",
        "Finance",
        "Governance",
        "Reviewer"
      ]
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Approval scope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "work_order_id",
        "action",
        "target",
        "environment",
        "policy_version",
        "artifact_digest",
        "idempotency_key"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "work_order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "environment": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
