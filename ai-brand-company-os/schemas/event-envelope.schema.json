{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized event contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_name",
    "schema_version",
    "source",
    "source_event_id",
    "occurred_at",
    "received_at",
    "environment",
    "entity_ref",
    "correlation_id",
    "consent_ref",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "event_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": [
        "offline",
        "staging",
        "production"
      ]
    },
    "entity_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "consent_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "payload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Minimized event fields",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "amount_vnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "const": "VND"
        },
        "product_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "attribution_class": {
          "enum": [
            "organic",
            "paid",
            "affiliate",
            "direct",
            "unknown"
          ]
        }
      }
    }
  }
}
