{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline work order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "objective_id",
    "action",
    "assigned_to",
    "requested_by",
    "environment",
    "policy_version",
    "status",
    "created_at",
    "expires_at",
    "idempotency_key",
    "input_refs",
    "artifact_digest",
    "dependencies",
    "acceptance_criteria",
    "max_cost_vnd"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "const": 1
    },
    "objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "assigned_to": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "environment": {
      "enum": [
        "offline",
        "staging",
        "production"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "REQUESTED",
        "PLANNED",
        "IN_PROGRESS",
        "QA_PENDING",
        "APPROVAL_PENDING",
        "READY",
        "EXECUTING",
        "RECONCILING",
        "DONE",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "input_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Input ref",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "version",
          "digest"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifact_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "max_cost_vnd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
