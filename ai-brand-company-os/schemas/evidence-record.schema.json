{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Truth and rights evidence contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "source_uri",
    "source_version",
    "digest",
    "scope",
    "observed_at",
    "expires_at",
    "reviewer_id",
    "status",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "kind": {
      "enum": [
        "product",
        "claim",
        "service_policy",
        "asset_rights",
        "payment",
        "consent"
      ]
    },
    "source_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONFLICT",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4000
    }
  }
}
