{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production budget contract, not spending authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "gate_receipt_id",
    "currency",
    "amount_total_vnd",
    "daily_limit_vnd",
    "committed_vnd",
    "settled_vnd",
    "account_id",
    "campaign_scope",
    "valid_from",
    "expires_at",
    "policy_version",
    "source_close_id",
    "finance_receipt_id",
    "governance_receipt_id",
    "owner_receipt_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "gate_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "currency": {
      "const": "VND"
    },
    "amount_total_vnd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "daily_limit_vnd": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "committed_vnd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "settled_vnd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "campaign_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_close_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "finance_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "governance_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "owner_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
